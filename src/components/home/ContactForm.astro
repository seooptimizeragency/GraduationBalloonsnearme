---
---
<section id="contact" data-spy>
  <div class="container">
    <div class="band"><h2>Contact Form</h2></div>
    <form class="inquiry-form" id="inquiryForm" method="post" enctype="multipart/form-data">
      <div class="field">
        <label for="cf-name">Name</label>
        <input type="text" id="cf-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="cf-email">Email</label>
        <input type="email" id="cf-email" name="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="cf-phone">Text Phone Number</label>
        <input type="tel" id="cf-phone" name="phone" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="cf-date">Event Date</label>
        <input type="date" id="cf-date" name="event_date" required />
      </div>
      <div class="field">
        <label for="cf-zip">Delivery Zip Code</label>
        <input type="text" id="cf-zip" name="delivery_zip" inputmode="numeric" required />
      </div>
      <div class="field">
        <label for="cf-occasion">Occasion / Event / theme if any</label>
        <select id="cf-occasion" name="occasion">
          <option>Birthday</option>
          <option selected>Graduation</option>
          <option>Wedding</option>
          <option>Corporate</option>
          <option>Baby Shower</option>
          <option>Other</option>
        </select>
      </div>
      <div class="field">
        <label for="cf-msg">Message</label>
        <textarea id="cf-msg" name="message" required placeholder="Tell us about your event, colors, and what you need"></textarea>
      </div>
      <div class="field">
        <label for="cf-file">Attach design you like</label>
        <input type="file" id="cf-file" name="attachment" />
      </div>
      <div class="cf-check" aria-hidden="true">
        <label class="cf-check-box">
          <input type="checkbox" tabindex="-1" />
          <span>Verify you are human</span>
        </label>
        <span class="cf-brand">Cloudflare</span>
      </div>
      <button type="submit" class="btn btn-yellow btn-wide">Send</button>
      <p class="form-note" id="formNote"></p>
    </form>
  </div>
</section>
<style>
  .cf-check{
    display:flex;align-items:center;justify-content:space-between;
    border:1px solid #d3d3d3;border-radius:6px;background:#fafafa;
    padding:12px 16px;margin:6px 0 20px;max-width:340px;
  }
  .cf-check-box{display:flex;align-items:center;gap:10px;cursor:default;font-size:.92rem;color:#333}
  .cf-check-box input{width:20px;height:20px;accent-color:#f6821f;cursor:default}
  .cf-brand{font-size:.72rem;color:#8a8a8a;font-weight:600}
</style>
