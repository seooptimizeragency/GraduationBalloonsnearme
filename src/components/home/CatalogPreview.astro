---
const cards = [
  { img: '/images/00-tulle-confetti-glitter-sparkle-balloons.avif', title: 'Tulle Confetti', desc: 'Sparkling tulle and confetti balloons for a glamorous touch.' },
  { img: '/images/01-round-jumbo-led-clear-personalize-balloons-.avif', title: 'Round Jumbo', desc: 'Giant round balloons, LED-lit and personalized for your grad.' },
  { img: '/images/02-number-name-letters-age-milestone-balloons.avif', title: 'Letter Balloons', desc: 'Foil letter balloons to spell names, years, and milestones.' },
  { img: '/images/03-gold-number-balloons.avif', title: 'Number Balloons', desc: 'Gold number balloons for the class year and ages.' },
  { img: '/images/04-confetti-chrome-glitter-balloons.avif', title: 'Confetti Chrome', desc: 'Chrome-finish balloons filled with colorful confetti.' },
  { img: '/images/05-big-giant-large-round-jumbo-balloons.avif', title: 'Big Round Balloon', desc: 'Oversized round balloons that make a bold statement.' },
  { img: '/images/06-balloons-tower-stand-1.avif', title: 'Tower Balloons', desc: 'Stacked balloon towers for entrances and stages.' },
  { img: '/images/07-balloons-half-arch-1.avif', title: 'Half Arch Balloons', desc: 'Organic half arches for backdrops and photo walls.' },
];
---
<section id="catalog" data-spy>
  <div class="container">
    <div class="band"><h2>Catalog</h2></div>
    <div class="card-grid">
      {cards.map(c => (
        <article class="cat-card">
          <img src={c.img} alt={c.title} loading="lazy" />
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
          <a class="btn btn-blue" href="/catalog.html">View</a>
        </article>
      ))}
    </div>
    <a class="btn btn-yellow btn-wide" href="/catalog.html">Full Catalog</a>
  </div>
</section>
