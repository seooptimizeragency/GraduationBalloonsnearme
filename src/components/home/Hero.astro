    <div class="video-single">
      <iframe
        src="https://www.youtube.com/embed/VbV9hOF0bfA"
        title="Graduation Balloons video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
