---
interface Props { active?: string; }
const { active = 'home' } = Astro.props;
const link = (id: string, href: string, label: string) =>
  `<a href="${href}" class="${active === id ? 'active' : ''}" ${href.startsWith('#') ? `data-spy-link` : ''}>${label}</a>`;
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Balloons Lane home">
      <span class="logo-balloon" aria-hidden="true"></span>
      <span>Balloons Lane</span>
    </a>
    <div class="header-contact">
      <span aria-hidden="true">✉</span>
      <a href="mailto:laneballoon@gmail.com"><span class="hide-m">laneballoon@gmail.com</span><span style="display:none">mail</span></a>
    </div>
    <nav class="main-nav" aria-label="Main navigation">
      <Fragment set:html={link('home', '/', 'Home')} />
      <Fragment set:html={link('catalog', '/catalog.html', 'Catalog')} />
      <Fragment set:html={link('corporate', '/#corporate', 'Corporate')} />
      <Fragment set:html={link('video', '/#videos', 'YT Video')} />
      <Fragment set:html={link('contact', '/contact-form.html', 'Contact Form')} />
    </nav>
    <div class="header-contact">
      <span aria-hidden="true">☎</span>
      <a href="tel:+17186752820">718.675.2820</a>
    </div>
    <div class="header-social" aria-label="Social links">
      <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">f</a>
      <a href="https://twitter.com/" target="_blank" rel="noopener" aria-label="Twitter">t</a>
      <a href="https://www.youtube.com/" target="_blank" rel="noopener" aria-label="YouTube">▶</a>
      <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">ig</a>
      <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
    </div>
  </div>
</header>
