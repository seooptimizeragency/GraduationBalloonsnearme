---
import { everyday, occasionGallery, holidayGallery, colorStoreGallery } from "./data";
---
<section aria-label="EveryDay">
  <div class="band"><h2>EveryDay</h2></div>
  <div class="card-grid">
    {everyday.map((p) => (
      <article class="cat-card">
        <img src={p.src} alt={p.alt} loading="lazy" />
        <h3>{p.title}</h3>
        <p>{p.blurb}</p>
        <a class="btn btn-blue" href="/contact-form.html">Order Now</a>
      </article>
    ))}
  </div>
</section>

<section aria-label="Occassion / Event">
  <div class="band"><h2>Occassion / Event</h2></div>
  <div class="gallery-grid">
    {occasionGallery.map((g) => (
      <figure>
        <img src={g.src} alt={g.alt} loading="lazy" />
        <figcaption>{g.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section aria-label="Holiday +">
  <div class="band"><h2>Holiday +</h2></div>
  <div class="gallery-grid">
    {holidayGallery.map((g) => (
      <figure>
        <img src={g.src} alt={g.alt} loading="lazy" />
        <figcaption>{g.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>

<section aria-label="Color + / Store">
  <div class="band"><h2>Color + / Store</h2></div>
  <div class="gallery-grid">
    {colorStoreGallery.map((g) => (
      <figure>
        <img src={g.src} alt={g.alt} loading="lazy" />
        <figcaption>{g.caption}</figcaption>
      </figure>
    ))}
  </div>
</section>
