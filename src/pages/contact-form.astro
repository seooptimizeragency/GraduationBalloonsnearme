---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<Head
  title="Contact Form | Balloons Lane"
  description="Contact Balloons Lane for custom balloon orders. Call 718.675.2820 or email laneballoon@gmail.com. Located at 109 Hastings St, Staten Island, NY 10305."
/>
<body>
  <Header active="contact" />

  <section class="contact-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p style="margin:14px 0 0">
        <a href="https://balloonslane.com" target="_blank" rel="noopener" class="btn btn-yellow">Balloons Order</a>
      </p>
    </div>
  </section>

  <main class="container">
    <div class="contact-cards">
      <div class="contact-card">
        <h3>Visit Us</h3>
        <a href="https://www.google.com/maps?q=109+Hastings+St,+Staten+Island,+NY+10305" target="_blank" rel="noopener">
          109 Hastings St, Staten Island, NY 10305
        </a>
      </div>
      <div class="contact-card">
        <h3>Call Us</h3>
        <a href="tel:+17186752820">718.675.2820</a>
      </div>
      <div class="contact-card">
        <h3>Email Us</h3>
        <a href="mailto:laneballoon@gmail.com">laneballoon@gmail.com</a>
      </div>
    </div>

    <div class="band"><h2>Find Us On The Map</h2></div>
    <div class="map-embed">
      <iframe
        title="Balloons Lane location map"
        src="https://www.google.com/maps?q=109+Hastings+St,+Staten+Island,+NY+10305&output=embed"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="band"><h2>Order Inquiry</h2></div>
    <form id="inquiryForm" class="inquiry-form" style="margin-bottom:40px">
      <div class="row">
        <div class="field">
          <label for="cf-name">Name</label>
          <input type="text" id="cf-name" name="name" required placeholder="Your name" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input type="email" id="cf-email" name="email" required placeholder="you@example.com" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="cf-phone">Phone</label>
          <input type="tel" id="cf-phone" name="phone" placeholder="Your phone number" />
        </div>
        <div class="field">
          <label for="cf-date">Event Date</label>
          <input type="date" id="cf-date" name="event_date" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="cf-zip">Delivery Zip</label>
          <input type="text" id="cf-zip" name="zip" placeholder="e.g. 10305" />
        </div>
        <div class="field">
          <label for="cf-occasion">Occasion</label>
          <select id="cf-occasion" name="occasion">
            <option>Graduation</option>
            <option>Birthday</option>
            <option>Wedding</option>
            <option>Corporate Event</option>
            <option>Baby Shower</option>
            <option>Holiday</option>
            <option>Other</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="cf-message">Message</label>
        <textarea id="cf-message" name="message" placeholder="Tell us about your event, colors, theme..."></textarea>
      </div>
      <div class="field">
        <label for="cf-file">Attach a file (optional)</label>
        <input type="file" id="cf-file" name="attachment" />
      </div>
      <div class="field">
        <label style="display:flex;align-items:center;gap:10px;font-weight:400">
          <input type="checkbox" required /> Verify you are human
        </label>
      </div>
      <button type="submit" class="btn btn-yellow btn-wide">Send</button>
      <p id="formNote" class="form-note"></p>
    </form>

    <div class="band"><h2>Follow Us</h2></div>
    <div class="social-row">
      <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook">f</a>
      <a href="https://twitter.com/" target="_blank" rel="noopener" aria-label="Twitter">t</a>
      <a href="https://www.instagram.com/" target="_blank" rel="noopener" aria-label="Instagram">ig</a>
      <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
      <a href="https://www.pinterest.com/" target="_blank" rel="noopener" aria-label="Pinterest">p</a>
      <a href="https://www.youtube.com/" target="_blank" rel="noopener" aria-label="YouTube">▶</a>
    </div>
  </main>

  <Footer />
  <script is:inline src="/js/main.js"></script>
</body>
</html>
