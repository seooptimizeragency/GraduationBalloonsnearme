---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ContactForm from '../components/home/ContactForm.astro';
import CatalogPreview from '../components/home/CatalogPreview.astro';
import Corporate from '../components/home/Corporate.astro';
import Videos from '../components/home/Videos.astro';
import Faq from '../components/home/Faq.astro';
import SeoCopy from '../components/home/SeoCopy.astro';
import Locations from '../components/home/Locations.astro';
---
<html lang="en">
<Head
  title="Best Graduation Balloons Near Me | Balloon Delivery & Decor"
  description="Looking for graduation balloons near me? Get custom balloon bouquets, arches, and decorations for your celebration. Same-day local delivery available. Order now!"
/>
<body>
  <Header active="home" />
  <main>
    <Hero />
    <ContactForm />
    <CatalogPreview />
    <Corporate />
    <Videos />
    <Faq />
    <SeoCopy />
    <Locations />
  </main>
  <Footer />
  <script is:inline src="/js/main.js"></script>
</body>
</html>
